# 이 파일을 .env 로 복사해서 값을 채워주세요.
# cp .env.example .env

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=piuda

# Gemini API (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flsk key
FLASK_SECRET_KEY=some_secret_string


# frontend/.env
EXPO_PUBLIC_API_URL=http://XXX.XXX.X.X:5001